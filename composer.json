{
    "name": "onlime/laravel-http-client-global-logger",
    "description": "A global logger for the Laravel HTTP Client",
    "type": "library",
    "keywords": [
        "onlime",
        "laravel-http-client-global-logger",
        "laravel",
        "http-client",
        "guzzle",
        "saloon",
        "log",
        "logger",
        "logging",
        "psr3"
    ],
    "homepage": "https://github.com/onlime/laravel-http-client-global-logger",
    "license": "MIT",
    "authors": [
        {
            "name": "Philip Iezzi",
            "email": "philip@onlime.ch",
            "role": "Developer"
        },
        {
            "name": "Onlime GmbH",
            "homepage": "https://www.onlime.ch/"
        }
    ],
    "support": {
        "issues": "https://github.com/onlime/laravel-http-client-global-logger/issues",
        "source": "https://github.com/onlime/laravel-http-client-global-logger"
    },
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "monolog/monolog": "^3.9"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7 || ^5.3",
        "saloonphp/laravel-plugin": "^4.3 || ^5.0",
        "spatie/invade": "^2.2"
    },
    "suggest": {
        "saloonphp/laravel-plugin": "Enable logging of Saloon HTTP client events"
    },
    "autoload": {
        "psr-4": {
            "Onlime\\LaravelHttpClientGlobalLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Onlime\\LaravelHttpClientGlobalLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "testbench:reset": "echo RESETTING TESTBENCH; rm -rf vendor/orchestra/testbench-core/laravel-foo",
        "pretest": "@testbench:reset",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-html=build/coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Onlime\\LaravelHttpClientGlobalLogger\\Providers\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
